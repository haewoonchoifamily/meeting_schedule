# 로컬 개발용 값. 이 파일을 .dev.vars 로 복사해 쓴다.
# 실제 배포는 `wrangler secret put` 을 쓴다. .dev.vars 는 커밋되지 않는다.

SESSION_SECRET = "아무 긴 임의 문자열"
ADVISOR_PASSWORD = "교수 로그인 비밀번호"

# 구글 캘린더 연동(서비스 계정)을 로컬에서도 시험할 때만.
# 자세한 절차는 README 의 "3. 구글 캘린더 연동" 참고.
# GOOGLE_SA_EMAIL = "...@....iam.gserviceaccount.com"
# GOOGLE_SA_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID = "교수님Gmail주소@gmail.com"
